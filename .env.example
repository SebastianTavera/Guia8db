# Copie este archivo como .env (está en .gitignore: nunca lo suba a GitHub)
#   Linux:    cp .env.example .env
#   Windows:  Copy-Item .env.example .env
# Los scripts lo leen solos (python-dotenv).

# --- Actividades 1 a 3: MySQL / MariaDB ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=guia8
DB_PASSWORD=Guia8-2026
DB_NAME=Guia_8

# --- Actividad 4: MongoDB ---
# Local (recomendado):
MONGO_URI=mongodb://127.0.0.1:27017
# Atlas (opcional): Atlas > Connect > Drivers > Python, cambiando <db_password> por la clave real
# MONGO_URI=mongodb+srv://usuario:clave@cluster0.xxxxx.mongodb.net/
MONGO_DB=tienda_ropa
# Clave para entrar a /admin (elija una propia)
ADMIN_PASSWORD=Admin2026
# Firma de la cookie de sesión de los clientes. Genere una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambie-esta-clave-larga
